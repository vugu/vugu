<!-- a simple set of radio buttons, used in this case to pick a language -->
<div id="radiobuttons">
    <!-- create the 4 radio buttons in the group, passing the properties we would nornmally set in JS as -->
    <!-- fields in the underlying Go struct. The Language Radio Button can then read these fields to determine -->
    <!-- if it is the selected default option. -->
    <!-- In this case 'c' is the containing radio buttons not the language radio button itself -->
    <vg-type vg-pkg="main" vg-struct="Languageradiobutton" vg-field="Group=c" Id="english" Value="English"></vg-type>
    <vg-type vg-pkg="main" vg-struct="Languageradiobutton" vg-field="Group=c" Id="french" Value="Français"></vg-type>
    <vg-type vg-pkg="main" vg-struct="Languageradiobutton" vg-field="Group=c" Id="italian" Value="Italiano"></vg-type>
    <vg-type vg-pkg="main" vg-struct="Languageradiobutton" vg-field="Group=c" Id="german" Value="Deutsch"></vg-type>

</div>